#!/usr/bin/env python3
"""
Playwright CLI wrapper for Derek agent.
Usage:
  pw screenshot <url> [outfile.png]
  pw text <url> <css-selector>
  pw fetch <url>
  pw run <actions.json>
"""
import sys, os, json, subprocess, tempfile

BROWSER_JS = os.path.join(os.path.dirname(__file__), "browser.js")

def run_actions(actions):
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        json.dump(actions, f)
        tmp = f.name
    try:
        result = subprocess.run(
            ["node", BROWSER_JS, tmp],
            capture_output=True, text=True
        )
        if result.returncode != 0:
            print("ERROR:", result.stderr[:500], file=sys.stderr)
            sys.exit(1)
        return json.loads(result.stdout)
    finally:
        os.unlink(tmp)

cmd = sys.argv[1] if len(sys.argv) > 1 else ""

if cmd == "screenshot":
    url = sys.argv[2]
    out = sys.argv[3] if len(sys.argv) > 3 else "screenshot.png"
    results = run_actions([
        {"action": "navigate", "url": url},
        {"action": "wait", "ms": 1500},
        {"action": "screenshot", "path": out, "fullPage": True},
    ])
    print(json.dumps(results, indent=2))

elif cmd == "text":
    url = sys.argv[2]
    selector = sys.argv[3] if len(sys.argv) > 3 else "body"
    results = run_actions([
        {"action": "navigate", "url": url},
        {"action": "wait", "ms": 1500},
        {"action": "get_text", "selector": selector},
    ])
    for r in results:
        if r.get("action") == "get_text":
            print(r.get("text", ""))

elif cmd == "fetch":
    url = sys.argv[2]
    results = run_actions([
        {"action": "navigate", "url": url},
        {"action": "wait", "ms": 1500},
        {"action": "get_text", "selector": "body"},
        {"action": "screenshot", "path": "fetch-screenshot.png"},
    ])
    for r in results:
        if r.get("action") == "get_text":
            print(r.get("text", "")[:3000])

elif cmd == "run":
    actions_file = sys.argv[2]
    with open(actions_file) as f:
        actions = json.load(f)
    results = run_actions(actions)
    print(json.dumps(results, indent=2))

else:
    print(__doc__)
    sys.exit(1)
