<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.{{AGENT_NAME}}.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{HOME_DIR}}/.claude/launcher.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ANTHROPIC_API_KEY</key>
        <string>{{ANTHROPIC_API_KEY}}</string>
        <key>SUPABASE_URL</key>
        <string>{{SUPABASE_URL}}</string>
        <key>SUPABASE_SERVICE_KEY</key>
        <string>{{SUPABASE_SERVICE_KEY}}</string>
        <key>AGENT_NAME</key>
        <string>{{AGENT_NAME}}</string>
        <key>HOME</key>
        <string>{{HOME_DIR}}</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>{{HOME_DIR}}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{HOME_DIR}}/.claude/daemon-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME_DIR}}/.claude/daemon-stderr.log</string>
</dict>
</plist>
