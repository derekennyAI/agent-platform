# Required — Anthropic API key for Claude Code
ANTHROPIC_API_KEY=sk-ant-...

# Required — Supabase project (stores credentials, skills, permissions, scheduled tasks)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Optional — GitHub PAT for repo access
GITHUB_TOKEN=ghp_...

# Optional — Notion API key (for project scoper skill)
NOTION_API_KEY=ntn_...

# Optional — Telegram bot token (for chat interface)
TELEGRAM_BOT_TOKEN=123456:ABC...

# Optional — Claude OAuth token (for Max subscription users)
CLAUDE_CODE_OAUTH_TOKEN=

# Set by the platform — don't change
# AGENT_NAME is set automatically per-agent by the MCP server
